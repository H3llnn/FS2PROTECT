# Bot induk dari BotFather; jangan isi token bot anak di sini.
MASTER_BOT_TOKEN=
# ID pengguna Telegram pemilik bot induk (angka positif).
MASTER_OWNER_ID=
# Hasil python -m subgate.keygen; simpan secara privat dan cadangkan.
SECRET_KEY=
# Disk persisten; jangan memakai direktori sementara.
DATA_DIR=./data
